if(NOT TARGET wasmtime::wasmtime)
    get_filename_component(_WASMTIME_PREFIX "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)

    add_library(wasmtime::wasmtime STATIC IMPORTED)
    set_target_properties(wasmtime::wasmtime PROPERTIES
        IMPORTED_CONFIGURATIONS "Debug;Release"
        IMPORTED_LOCATION_DEBUG "${_WASMTIME_PREFIX}/debug/lib/wasmtime.lib"
        IMPORTED_LOCATION_RELEASE "${_WASMTIME_PREFIX}/lib/wasmtime.lib"
        MAP_IMPORTED_CONFIG_MINSIZEREL Release
        MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release
        INTERFACE_INCLUDE_DIRECTORIES "${_WASMTIME_PREFIX}/include"
        INTERFACE_COMPILE_DEFINITIONS "WASM_API_EXTERN=;WASI_API_EXTERN="
        INTERFACE_LINK_LIBRARIES "ws2_32;advapi32;userenv;ntdll;shell32;ole32;bcrypt"
    )

    unset(_WASMTIME_PREFIX)
endif()
